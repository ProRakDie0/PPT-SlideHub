{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "noEmitOnError": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "ES2020",
    "lib": [
      "es2015",
      "dom"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*" 
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "lib-amd",
    "test", 
    "webpack.config.js",
    "convertToSingleHost.js"
  ],
  "ts-node": {
    "files": true
  }
}